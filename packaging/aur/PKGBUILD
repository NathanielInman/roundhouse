# Maintainer: Nathaniel Inman <nate@theoestudio.com>
# Generated by packaging/render.py on release.
pkgname=roundhouse
pkgver=0.3.0
pkgrel=1
pkgdesc="One lamp in your bar; the whole machine slides out of it"
arch=('x86_64' 'aarch64')
url="https://github.com/NathanielInman/roundhouse"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'gcc-libs' 'glibc' 'hwdata')
optdepends=('nvidia-utils: NVIDIA GPU readings through NVML'
            'pipewire: quantum, DSP load and dropouts on the Machine tab'
            'waybar: the bar the lamp lives in')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('117ea4c88acebc839f8d6ca016627e87cd0e82d9dd502e23fbdcb5e99b8ae424')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p rh -p rh-board
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p rh-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/rh "$pkgdir/usr/bin/rh"
  install -Dm755 target/release/rh-board "$pkgdir/usr/bin/rh-board"
  sed 's|@BINDIR@|/usr/bin|' packaging/systemd/roundhouse.service > "$srcdir/roundhouse.service"
  install -Dm644 "$srcdir/roundhouse.service" "$pkgdir/usr/lib/systemd/user/roundhouse.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/design.md "$pkgdir/usr/share/doc/$pkgname/design.md"
}
